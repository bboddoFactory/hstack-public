    {"kind": "return", "from": "maker", "to": "main", "label": "보고서 경로"},
    {"kind": "return", "from": "main", "to": "user", "label": "허브에 올렸다"},
    {"from": "user", "to": "browser", "label": "허브 열기"},
    {"from": "browser", "to": "hub", "label": "목록과 페이지 요청", "undecided": "새 자료 알림 방식은 미정이다"},
    {"from": "hub", "to": "folder", "label": "읽기"},
    {"kind": "return", "from": "hub", "to": "browser", "label": "목록과 페이지"}
