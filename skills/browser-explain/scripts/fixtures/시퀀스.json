    {"id": "cli", "name": "스킬 CLI", "change": "new"},
    {"id": "engine", "name": "그림 엔진"},
    {"id": "checker", "name": "페이지 검사"},
    {"id": "folder", "role": "store", "name": "작업 폴더"},
    {"id": "hub", "name": "허브 서버", "change": "new"},
    {"id": "browser", "role": "external", "name": "브라우저"}
  ],
  "messages": [
    {"from": "user", "to": "main", "label": "작업 이야기"},
    {"from": "main", "to": "folder", "label": "요청서 쓰기"},
    {"from": "main", "to": "maker", "label": "제작 맡김"},
    {"from": "maker", "to": "cli", "label": "describe"},
    {"kind": "return", "from": "cli", "to": "maker", "label": "입력 설명"},
    {"from": "maker", "to": "folder", "label": "원본과 입력 쓰기"},
    {"from": "maker", "to": "cli", "label": "draw"},
    {"from": "cli", "to": "engine", "label": "그리게 함"},
    {"from": "cli", "to": "folder", "label": "SVG 저장"},
    {"kind": "alt", "branches": [
      {"condition": "입력이 맞다", "messages": [
        {"kind": "return", "from": "cli", "to": "maker", "label": "짧은 결과"}
      ]},
      {"condition": "입력이 틀리다", "messages": [
        {"kind": "return", "from": "cli", "to": "maker", "label": "고칠 곳"},
        {"from": "maker", "to": "maker", "label": "고쳐 다시 draw"}
      ]}
    ]},
    {"from": "maker", "to": "cli", "label": "build", "undecided": "그림 넣는 방식은 미정이다"},
    {"from": "cli", "to": "folder", "label": "완성 페이지 쓰기"},
    {"from": "maker", "to": "cli", "label": "check"},
